{
 "steps": [
  {
   "action": "eval",
   "label": "search-icon-is-magnifier",
   "script": "(()=>{const b=document.getElementById('search-btn');const svg=b&&b.querySelector('svg');const d=svg?[...svg.querySelectorAll('path')].map(p=>p.getAttribute('d')).join(' '):'';return !!svg && d.includes('15.6 15.6') && b.querySelectorAll('svg').length===1})()",
   "expect": true
  },
  {
   "action": "eval",
   "label": "no-duplicate-magnifier",
   "script": "document.querySelectorAll('.sp-searchbox svg').length",
   "expect": 1
  },
  {
   "action": "eval",
   "label": "load-artist",
   "script": "(async()=>{const d=await (await fetch('/api/artist?name=Sylosis')).json();NP_ARTIST_CACHE.set('Sylosis',d);paintArtist(d);const a=await (await fetch('/api/artist/about?name=Sylosis')).json();NP_ABOUT_CACHE.set('Sylosis',a);paintArtistAbout(a,'Sylosis');return true})()",
   "expect": true
  },
  {
   "action": "wait",
   "ms": 800
  },
  {
   "action": "assertSelectorCount",
   "selector": "#np-albums .np-album",
   "min": 5
  },
  {
   "action": "assertSelectorCount",
   "selector": "#np-videos .np-video",
   "min": 3
  },
  {
   "action": "assertSelectorCount",
   "selector": "#np-events .np-event",
   "min": 3
  },
  {
   "action": "assertSelectorCount",
   "selector": "#np-photos .np-photo",
   "min": 1
  },
  {
   "action": "assertSelectorCount",
   "selector": "#np-artist-facts .np-fact",
   "min": 3
  },
  {
   "action": "eval",
   "label": "members-shown",
   "script": "!document.getElementById('np-artist-members').hidden && document.getElementById('np-artist-members').textContent.includes('Sestava')",
   "expect": true
  },
  {
   "action": "eval",
   "label": "bio-is-full-text",
   "script": "document.getElementById('np-artist-desc').textContent.length>400",
   "expect": true
  },
  {
   "action": "eval",
   "label": "bio-toggle-expands",
   "script": "(()=>{const d=document.getElementById('np-artist-desc'),m=document.getElementById('np-artist-more');if(m.hidden)return !d.classList.contains('clamped');m.click();return !d.classList.contains('clamped')&&m.textContent==='Zobrazit méně'})()",
   "expect": true
  },
  {
   "action": "eval",
   "label": "wiki-source-link",
   "script": "!document.getElementById('np-artist-wiki').hidden",
   "expect": true
  },
  {
   "action": "eval",
   "label": "events-expand",
   "script": "(()=>{const m=document.getElementById('np-events-more');if(m.hidden)return true;const before=document.querySelectorAll('#np-events .np-event').length;m.click();return document.querySelectorAll('#np-events .np-event').length>before})()",
   "expect": true
  },
  {
   "action": "eval",
   "label": "photo-lightbox",
   "script": "(()=>{document.querySelector('#np-photos .np-photo').click();const has=!!document.querySelector('.np-lightbox');document.querySelector('.np-lightbox').click();return has && !document.querySelector('.np-lightbox')})()",
   "expect": true
  },
  {
   "action": "eval",
   "label": "photos-proxied",
   "script": "[...document.querySelectorAll('#np-photos .np-photo')].every(b=>b.style.backgroundImage.includes('/api/thumb'))",
   "expect": true
  },
  {
   "action": "screenshot",
   "label": "artist-panel"
  },
  {
   "action": "eval",
   "label": "click-album-opens-stage",
   "script": "(()=>{document.querySelectorAll('#np-albums .np-album')[2].click();return true})()",
   "expect": true
  },
  {
   "action": "eval",
   "label": "home-dates-come-first",
   "script": "(()=>{const a=(NP_ABOUT_CACHE.get('Sylosis')||{}).events||[];if(!a.some(e=>e.home))return 'no-home-dates';const firstAway=a.findIndex(e=>!e.home);const lastHome=a.map(e=>e.home).lastIndexOf(true);return firstAway===-1||lastHome<firstAway})()",
   "expect": true
  },
  {
   "action": "eval",
   "label": "the-two-groups-are-labelled",
   "script": "(()=>{const h=[...document.querySelectorAll('#np-events .np-ev-group')].map(e=>e.textContent);return h.length>0&&h[0].includes('Česku')})()",
   "expect": true
  },
  {
   "action": "wait",
   "ms": 3500
  },
  {
   "action": "eval",
   "label": "stage-has-album-tracks",
   "script": "(!document.getElementById('overlay').hidden) && document.querySelectorAll('#panel .pl-row, #panel .track-row, #panel tr').length>3",
   "expect": true
  },
  {
   "action": "screenshot",
   "label": "album-in-stage"
  }
 ]
}